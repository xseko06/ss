    echo 'echo ""' >> /home/serkan/.bashrc

WORKDIR /home/serkan
USER serkan

# 6. Wetty'yi 3000 portunda başlat
CMD ["wetty", "--port", "3000", "--base", "/", "--command", "/bin/bash"]
